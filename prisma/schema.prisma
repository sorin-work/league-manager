generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  createdAt    DateTime  @default(now())
  sessions     Session[]
}

model Session {
  id        String    @id @default(cuid())
  /// sha256 of the cookie value, the raw token is never stored
  tokenHash String    @unique
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([userId])
}

enum FixtureFormat {
  SINGLE
  DOUBLE
}

model Season {
  id              String     @id @default(cuid())
  name            String
  slug            String     @unique
  startDate       DateTime   @db.Date
  endDate         DateTime   @db.Date
  /// IANA time zone used for kick-off times, e.g. Europe/London
  timezone        String     @default("Europe/London")
  pointsForWin    Int        @default(3)
  pointsForDraw   Int        @default(1)
  pointsForLoss   Int        @default(0)
  tiebreakers     String[]   @default(["GOAL_DIFFERENCE", "GOALS_FOR", "HEAD_TO_HEAD"])
  yellowCardLimit Int        @default(5)
  yellowCardBan   Int        @default(1)
  redCardBan      Int        @default(1)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  divisions       Division[]
}

model Division {
  id        String        @id @default(cuid())
  seasonId  String
  season    Season        @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  name      String
  slug      String
  format    FixtureFormat @default(SINGLE)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  teams     Team[]
  matches   Match[]

  @@unique([seasonId, slug])
}

model Team {
  id          String   @id @default(cuid())
  divisionId  String
  division    Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  name        String
  shortName   String?
  slug        String
  homeVenueId String?
  homeVenue   Venue?   @relation(fields: [homeVenueId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  players     Player[]
  homeMatches Match[]  @relation("HomeTeam")
  awayMatches Match[]  @relation("AwayTeam")

  @@unique([divisionId, slug])
}

model Player {
  id          String       @id @default(cuid())
  teamId      String
  team        Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  name        String
  shirtNumber Int?
  createdAt   DateTime     @default(now())
  events      MatchEvent[]

  @@unique([teamId, shirtNumber])
  @@index([teamId])
}

model Venue {
  id        String   @id @default(cuid())
  name      String
  address   String?
  createdAt DateTime @default(now())
  teams     Team[]
  matches   Match[]
}

enum MatchStatus {
  SCHEDULED
  PLAYED
  POSTPONED
  CANCELLED
}

model Match {
  id         String       @id @default(cuid())
  divisionId String
  division   Division     @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  round      Int
  homeTeamId String
  homeTeam   Team         @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeamId String
  awayTeam   Team         @relation("AwayTeam", fields: [awayTeamId], references: [id])
  venueId    String?
  venue      Venue?       @relation(fields: [venueId], references: [id], onDelete: SetNull)
  kickoffAt  DateTime?
  status     MatchStatus  @default(SCHEDULED)
  homeScore  Int?
  awayScore  Int?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  events     MatchEvent[]

  @@index([divisionId, round])
}

enum EventType {
  GOAL
  PENALTY_GOAL
  OWN_GOAL
  YELLOW_CARD
  RED_CARD
}

/// A goal or a card. teamId is the player's own team, also for own goals.
model MatchEvent {
  id        String    @id @default(cuid())
  matchId   String
  match     Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  playerId  String
  player    Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  teamId    String
  type      EventType
  minute    Int?
  createdAt DateTime  @default(now())

  @@index([matchId])
  @@index([playerId])
}
