generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FixtureFormat {
  SINGLE
  DOUBLE
}

model Season {
  id              String     @id @default(cuid())
  name            String
  slug            String     @unique
  startDate       DateTime   @db.Date
  endDate         DateTime   @db.Date
  /// IANA time zone used for kick-off times, e.g. Europe/London
  timezone        String     @default("Europe/London")
  pointsForWin    Int        @default(3)
  pointsForDraw   Int        @default(1)
  pointsForLoss   Int        @default(0)
  tiebreakers     String[]   @default(["GOAL_DIFFERENCE", "GOALS_FOR", "HEAD_TO_HEAD"])
  yellowCardLimit Int        @default(5)
  yellowCardBan   Int        @default(1)
  redCardBan      Int        @default(1)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  divisions       Division[]
}

model Division {
  id        String        @id @default(cuid())
  seasonId  String
  season    Season        @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  name      String
  slug      String
  format    FixtureFormat @default(SINGLE)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  teams     Team[]
  matches   Match[]

  @@unique([seasonId, slug])
}

model Team {
  id          String   @id @default(cuid())
  divisionId  String
  division    Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  name        String
  shortName   String?
  slug        String
  homeVenueId String?
  homeVenue   Venue?   @relation(fields: [homeVenueId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  players     Player[]
  homeMatches Match[]  @relation("HomeTeam")
  awayMatches Match[]  @relation("AwayTeam")

  @@unique([divisionId, slug])
}

model Player {
  id          String   @id @default(cuid())
  teamId      String
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  name        String
  shirtNumber Int?
  createdAt   DateTime @default(now())

  @@unique([teamId, shirtNumber])
  @@index([teamId])
}

model Venue {
  id        String   @id @default(cuid())
  name      String
  address   String?
  createdAt DateTime @default(now())
  teams     Team[]
  matches   Match[]
}

enum MatchStatus {
  SCHEDULED
  PLAYED
  POSTPONED
  CANCELLED
}

model Match {
  id         String      @id @default(cuid())
  divisionId String
  division   Division    @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  round      Int
  homeTeamId String
  homeTeam   Team        @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeamId String
  awayTeam   Team        @relation("AwayTeam", fields: [awayTeamId], references: [id])
  venueId    String?
  venue      Venue?      @relation(fields: [venueId], references: [id], onDelete: SetNull)
  kickoffAt  DateTime?
  status     MatchStatus @default(SCHEDULED)
  homeScore  Int?
  awayScore  Int?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([divisionId, round])
}
